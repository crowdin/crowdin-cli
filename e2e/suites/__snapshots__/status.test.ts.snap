exports[`status rejects a language the project does not target 1`] = `"■  Language 'zz' doesn't exist in the project. Try specifying another language code"`;

exports[`status rejects --file and --directory together 1`] = `"■  Only one of the following options can be used at a time: '--file', '--directory'"`;

