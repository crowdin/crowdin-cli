`;

exports[`status adds word and phrase columns with --verbose 1`] = `
"●  Fetching project info
●  Fetching project progress
●  Loading configuration from '<workspace>/status/crowdin.yml' file
●  Project info fetched
●  Project progress fetched
┌───────────────┬────────────┬──────────────────┬────────────────────┬───────────┬─────────────────┬───────────────────┐
│               │ Translated │ Translated words │ Translated phrases │ Proofread │ Proofread words │ Proofread phrases │
├───────────────┼────────────┼──────────────────┼────────────────────┼───────────┼─────────────────┼───────────────────┤
│   Italian(it) │ 0%         │ 0/32             │ 0/8                │ 0%        │ 0/32            │ 0/8               │
│ Ukrainian(uk) │ 100%       │ 32/32            │ 8/8                │ 0%        │ 0/32            │ 0/8               │
└───────────────┴────────────┴──────────────────┴────────────────────┴───────────┴─────────────────┴───────────────────┘"
`;

